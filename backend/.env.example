# GetEasy Backend Environment Variables

# Server Port
PORT=5000

# JSON Web Token Secret
JWT_SECRET=geteasy_secret_key_123

# MongoDB Connection URI
# Uncomment and replace with your local MongoDB string or MongoDB Atlas connection string:
# MONGO_URI=mongodb://localhost:27017/geteasy
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/geteasy?retryWrites=true&w=majority

# Email Service Configuration (Gmail)
# Needs to be an App Password, not your regular Gmail password.
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
